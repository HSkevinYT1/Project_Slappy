  startHighlighted: 0
--- !u!114 &2133819977
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2133819974}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fee1288a302fd8d4293a583ca868f742, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  titulo: "Nota 1 \u2014 D\xEDa 1"
  texto: "No s\xE9 d\xF3nde estamos. Tampoco recuerdo c\xF3mo llegamos aqu\xED.\n\nHace
    un momento estaba con mis amigos en mi casa. Ninguno sabe qu\xE9 ocurri\xF3.
    No tenemos tel\xE9fonos, nuestras pertenencias desaparecieron y no recordamos
    c\xF3mo terminamos en esta isla.\n\nA lo lejos vimos un faro. Fue nuestra \xFAnica
    esperanza, as\xED que caminamos hasta \xE9l. Por suerte, todav\xEDa funciona.
    Encontramos algunas provisiones y decidimos refugiarnos aqu\xED mientras esperamos
    que alguien venga a buscarnos.\n\nHay algo extra\xF1o en este lugar. Desde las
    ventanas se puede ver un bosque que rodea pr\xE1cticamente toda la isla. Anoche
    escuchamos algo caminando entre los \xE1rboles. Pensamos que ser\xEDa alg\xFAn
    animal, pero los pasos eran demasiado pesados.\n\nTim dice haber visto una silueta
    entre los \xE1rboles. Era muy alta, demasiado alta para ser una persona.\n\nMa\xF1ana
    iremos a revisar el noreste de la playa. Quiz\xE1s encontremos alg\xFAn barco,
    herramientas o cualquier cosa que nos pueda servir para salir de aqu\xED. Tambi\xE9n
    vimos una peque\xF1a construcci\xF3n cerca de la costa."
  pie: "La br\xFAjula marca: NORESTE"
  prompt: Leer nota
  papel: {r: 0.86, g: 0.8, b: 0.66, a: 1}
  alLeer:
    m_PersistentCalls:
      m_Calls: []
