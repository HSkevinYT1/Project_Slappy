  startHighlighted: 0
--- !u!114 &1275648541
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1275648538}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fee1288a302fd8d4293a583ca868f742, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  titulo: "Nota 3 \u2014 D\xEDa 60"
  texto: "No s\xE9 cu\xE1nto tiempo m\xE1s podr\xE9 seguir escribiendo.\n\nAhora
    estoy solo.\n\nEn una de las salidas de Tim algo pas\xF3. Ni siquiera estoy seguro
    de haberlo entendido. Diego se volvi\xF3 loco y se suicid\xF3. Voy por el mismo
    camino. Todav\xEDa escucho pasos dentro del faro, aunque est\xE9 completamente
    solo.\n\nLa luz sigue funcionando, pero cada vez dura menos antes de apagarse
    por unos segundos. Esos segundos son suficientes para escuchar c\xF3mo algo se
    acerca.\n\nAnoche vi su silueta al otro lado del cristal. No se mov\xEDa. Simplemente
    estaba all\xED, observ\xE1ndome.\n\nCreo que sabe que solo quedo yo.\n\nHe estado
    buscando alguna manera de escapar. Record\xE9 que, cuando llegamos, vimos un
    peque\xF1o cobertizo cerca de la playa, en el este. Uno de los chicos mencion\xF3
    que hab\xEDa un dep\xF3sito subterr\xE1neo debajo de \xE9l.\n\nCreo que all\xED
    guardaban combustible. Si todav\xEDa queda gasolina, podr\xEDa ser nuestra \xFAnica
    oportunidad de sobrevivir, puede que la puerta se abra.\n\nNo quiero salir. No
    quiero volver a verlo.\n\nPero tampoco puedo quedarme aqu\xED para siempre.\n\nLa
    luz volvi\xF3 a apagarse."
  pie: "La br\xFAjula marca: ESTE"
  prompt: Leer nota
  papel: {r: 0.86, g: 0.8, b: 0.66, a: 1}
  alLeer:
    m_PersistentCalls:
      m_Calls: []
