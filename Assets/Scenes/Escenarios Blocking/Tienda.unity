--- !u!114 &36187030
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 36187027}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fee1288a302fd8d4293a583ca868f742, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  titulo: "Bit\xE1cora del faro"
  texto: "Registro del farero.\n\n12 de marzo. \u2014 El combustible lleg\xF3 tarde
    otra vez. La l\xE1mpara aguanta, pero no s\xE9 por cu\xE1ntas noches m\xE1s.\n\n3
    de abril. \u2014 Volv\xED a escuchar pasos alrededor del faro. Cuando la luz
    barre el bosque, a veces hay algo de pie entre los \xE1rboles. Cuando vuelve
    a pasar, ya no est\xE1.\n\n18 de abril. \u2014 No salgo de la luz. Guard\xE9
    lo que quedaba de combustible lejos del faro, por si la l\xE1mpara se incendia.\n\n21
    de abril. \u2014 Est\xE1 m\xE1s cerca.\n\n\u2014 \u2014 \u2014\n\nEncontramos
    esta bit\xE1cora al llegar. Del farero no hay rastro. Voy a ir dejando lo que
    escribo afuera, donde se pueda encontrar, por si alguien llega despu\xE9s de
    nosotros. La primera hoja est\xE1 cerca, saliendo por la puerta, entre los \xE1rboles."
  pie: "La br\xFAjula marca: OESTE"
  prompt: "Leer bit\xE1cora"
  papel: {r: 0.86, g: 0.8, b: 0.66, a: 1}
  alLeer:
    m_PersistentCalls:
      m_Calls: []
